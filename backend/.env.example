# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Postgres (docker compose maps host 5434 -> container 5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5434/swarmdev

# Required. Server refuses to start without it. Use a long random value.
JWT_SECRET=

# Required. 32-byte key for encrypting provider credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=

# File storage root for agent workspaces, worktrees, and run artifacts (defaults to ./data/storage)
STORAGE_ROOT=

# Optional on shared servers: directories registered repositories must live under,
# separated by the platform path delimiter (":" on macOS/Linux, ";" on Windows).
# Leave empty to accept any path on this machine.
REPOSITORY_ROOTS=

# Optional: JSON array overriding the built-in API agent catalog.
# Entries need protocol (openai|anthropic), model, and systemPrompt.
API_AGENT_CATALOG=
